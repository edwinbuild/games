{
  "name": "quick-games",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "pages": "node --experimental-strip-types design-system/build.ts && node --experimental-strip-types scripts/pages.ts",
    "dev": "npm run pages && vite",
    "build": "npm run pages && tsc -b && vite build && node scripts/preload.cjs && node scripts/sw.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "og": "node scripts/og.cjs",
    "tokens": "node --experimental-strip-types design-system/build.ts",
    "ds": "node --experimental-strip-types design-system/build.ts --bundle",
    "e2e": "node tests/e2e/run.cjs",
    "budget": "node scripts/budget.cjs"
  },
  "dependencies": {
    "@supabase/realtime-js": "^2.119.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
